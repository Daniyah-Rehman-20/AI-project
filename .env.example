# =============================================================================
# Enterprise AI Incident Intelligence Platform — Environment Variables
# Copy to .env and fill in values. Never commit secrets.
# =============================================================================

# Application
APP_NAME=Incident Intelligence Platform
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-long-random-secret-key-min-32-chars
APP_API_PREFIX=/api/v1
APP_FRONTEND_URL=http://localhost:3000
APP_BACKEND_URL=http://localhost:8000
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Database (SQLite for local; set DATABASE_URL to PostgreSQL in production)
DATABASE_URL=sqlite+aiosqlite:///./data/incident_intel.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/incident_intel
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=3600

# Apache Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CONSUMER_GROUP=incident-intel-workers
KAFKA_AUTO_OFFSET_RESET=earliest

# Qdrant Vector Store
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=incident_knowledge
QDRANT_API_KEY=

# MinIO / S3 Object Storage
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=incident-docs
S3_REGION=us-east-1
S3_USE_SSL=false

# JWT Authentication
JWT_SECRET_KEY=change-me-jwt-secret-key-min-32-chars-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback

# LLM Providers (configure at least one)
LLM_PROVIDER=gemini
# gemini | openai | ollama

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

# Embeddings
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# LangSmith Observability (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=incident-intelligence

# OpenTelemetry
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=incident-intel-api

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# External Integrations (optional)
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
SLACK_BOT_TOKEN=
SLACK_WEBHOOK_URL=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_URL=http://grafana:3000
GRAFANA_API_KEY=

# Worker
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=500

# Seed admin (development only)
SEED_ADMIN_EMAIL=admin@incident-intel.dev
SEED_ADMIN_PASSWORD=ChangeMeAdmin123!
SEED_ADMIN_NAME=Platform Admin
